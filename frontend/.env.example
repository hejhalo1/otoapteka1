# Szablon zmiennych frontendu — skopiuj do .env.local i uzupełnij.
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# (opcjonalnie) styl mapy MapLibre z public/map/: /map/basic.json (domyślny), /map/toner.json, /map/fiord.json
# NEXT_PUBLIC_MAP_STYLE=/map/basic.json
# Sekret rewalidacji on-demand (musi zgadzać się z REVALIDATE_SECRET backendu) — Faza 5.
REVALIDATE_SECRET=ZMIEN_MNIE_revalidate
