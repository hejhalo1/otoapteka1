// otoapteka.pl — schemat bazy.
// Fundamentalny podział: dane URZĘDOWE (z Rejestru Aptek, tylko moduł sync) vs
// dane DODATKOWE (od aptek, tylko panel). Egzekwowane rozdzieleniem tabel.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// =========================================================================
// ENUMY
// =========================================================================

// Wartości zmapowane ze stan_apteki w rejestrze (patrz SyncService.mapStatus).
// Rejestr używa m.in.: AKTYWNA, NIEAKTYWNA, "NIEAKTYWNA - ZAWIESZENIE DZIAŁALNOŚCI",
// "CZASOWO NIECZYNNA", "OCZEKUJĄCA", "UNIERUCHOMIONA DECYZJĄ WIF". Oryginał trzymamy
// dodatkowo w Pharmacy.statusRaw (audyt + odporność na nowe wartości).
enum PharmacyStatus {
  AKTYWNA
  NIEAKTYWNA
  ZAWIESZONA
  CZASOWO_NIECZYNNA
  OCZEKUJACA
  UNIERUCHOMIONA
  INNA
}

// Importujemy tylko apteki dostępne publicznie (rodzaj_apteki). Szpitalne/zakładowe pomijamy.
enum PharmacyKind {
  OGOLNODOSTEPNA
  PUNKT_APTECZNY
}

enum HoursSource {
  REGISTRY // z rejestru — nadpisywane przez sync
  PHARMACY // wpisane w panelu, gdy rejestr nie podaje godzin
}

enum AnnouncementType {
  PRODUCT_INFO
  HOURS_CHANGE
  VACCINATION
  CONSULTATION
  SCREENING
  NEW_SERVICE
  EVENT
  ORG_NOTICE
}

enum ModerationStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum Role {
  ADMIN
  PHARMACY_MANAGER
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SyncStatus {
  RUNNING
  SUCCESS
  PARTIAL // zakończony, ale z błędami per-wiersz
  FAILED
}

// =========================================================================
// DANE URZĘDOWE — pisze WYŁĄCZNIE moduł synchronizacji
// =========================================================================

model Pharmacy {
  id           String         @id @default(cuid())
  registryId   String         @unique // identyfikator_apteki z rejestru
  permitNumber String? // numer_zezwolenia (NIE unique — w rejestrze bywają powtórzenia)
  name         String
  kind         PharmacyKind
  status       PharmacyStatus
  statusRaw    String // oryginalny stan_apteki (audyt)
  ownerName    String? // wlasciciel_nazwa
  street       String // typ_ulicy + nazwa_ulicy + numer (złożone)
  city         String
  postalCode   String
  voivodeship  String
  county       String
  commune      String
  phone        String?
  website      String?

  // Geokodowanie (Nominatim) — NIE z rejestru.
  lat           Float?
  lng           Float?
  location      Unsupported("geography(Point, 4326)")? // kolumna PostGIS (indeks GiST w migracji)
  geocodedAt    DateTime?
  geocodeFailed Boolean                                @default(false) // ostatnia próba nieudana — nie ponawiaj w kółko

  slug                  String    @unique // nazwa-miasto[-n]; stabilny mimo zmian w rejestrze
  removedFromRegistryAt DateTime? // soft delete — nigdy nie kasujemy fizycznie

  // Sygnatura godzin z rejestru (konkat 8 kolumn). Pozwala nadpisywać OpeningHours(REGISTRY)
  // tylko gdy faktycznie się zmieniły — bez przepisywania godzin całej bazy przy każdym syncu.
  registryHoursKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile       PharmacyProfile?
  openingHours  OpeningHours[]
  dutyShifts    DutyShift[]
  announcements Announcement[]
  claims        PharmacyClaim[]
  managers      User[]
  changeLogs    PharmacyChangeLog[]

  @@index([voivodeship, city])
  @@index([status])
  @@index([geocodeFailed, geocodedAt]) // szukanie aptek do geokodowania
}

// Historia zmian pól przy synchronizacji.
model PharmacyChangeLog {
  id         String   @id @default(cuid())
  syncRunId  String
  pharmacyId String
  field      String
  oldValue   String?
  newValue   String?
  createdAt  DateTime @default(now())

  syncRun  SyncRun  @relation(fields: [syncRunId], references: [id], onDelete: Cascade)
  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@index([pharmacyId])
  @@index([syncRunId])
}

// Audyt każdej synchronizacji.
model SyncRun {
  id               String     @id @default(cuid())
  startedAt        DateTime   @default(now())
  finishedAt       DateTime?
  status           SyncStatus @default(RUNNING)
  resourceId       String? // id zasobu z dane.gov.pl
  resourceFormat   String? // format wybranego zasobu
  dataDate         String? // data_date wybranego zasobu
  totalRows        Int        @default(0)
  addedCount       Int        @default(0)
  updatedCount     Int        @default(0)
  deactivatedCount Int        @default(0)
  geocodedCount    Int        @default(0)
  errorLog         Json? // błędy per-wiersz + ostrzeżenia
  triggeredBy      String? // "cron" | userId admina

  changes PharmacyChangeLog[]

  @@index([startedAt])
}

// =========================================================================
// DANE DODATKOWE — pisze WYŁĄCZNIE panel apteki (ownership-guarded)
// =========================================================================

model PharmacyProfile {
  pharmacyId         String  @id
  logoUrl            String?
  description        String?
  email              String?
  phoneExtra         String?
  prescriptionPickup Boolean @default(false)
  featured           Boolean @default(false) // przyszła monetyzacja (wyróżnienie) — bez UI płatności

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pharmacy Pharmacy          @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  photos   Photo[]
  services PharmacyService[]
}

model OpeningHours {
  id         String      @id @default(cuid())
  pharmacyId String
  dayOfWeek  Int // 0=poniedziałek … 6=niedziela
  opensAt    Int // minuty od północy
  closesAt   Int // gdy < opensAt → zamknięcie następnego dnia (zmiana nocna)
  is24h      Boolean     @default(false)
  source     HoursSource

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@index([pharmacyId, dayOfWeek])
}

model DutyShift {
  id         String   @id @default(cuid())
  pharmacyId String
  startsAt   DateTime
  endsAt     DateTime
  note       String?
  createdAt  DateTime @default(now())

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@index([pharmacyId, startsAt])
}

model Announcement {
  id              String           @id @default(cuid())
  pharmacyId      String
  title           String
  body            String // plain text / sanityzowany markdown (patrz bezpieczeństwo)
  type            AnnouncementType
  status          ModerationStatus @default(PENDING)
  rejectionReason String?
  publishedAt     DateTime?
  expiresAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@index([pharmacyId, status])
  @@index([status, publishedAt])
}

// Słownik usług (szczepienia, pomiar ciśnienia, glukoza…).
model Service {
  id   String @id @default(cuid())
  name String
  slug String @unique

  pharmacies PharmacyService[]
}

model PharmacyService {
  id        String  @id @default(cuid())
  profileId String
  serviceId String
  note      String?

  profile PharmacyProfile @relation(fields: [profileId], references: [pharmacyId], onDelete: Cascade)
  service Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([profileId, serviceId])
}

model Photo {
  id        String           @id @default(cuid())
  profileId String
  url       String
  status    ModerationStatus @default(PENDING)
  createdAt DateTime         @default(now())

  profile PharmacyProfile @relation(fields: [profileId], references: [pharmacyId], onDelete: Cascade)

  @@index([profileId, status])
}

// =========================================================================
// GALERIA PROMOCYJNA (strona główna, zarządzana z panelu admina)
// =========================================================================

// Slajd auto-przewijanej galerii w pustym stanie strony głównej (przed lokalizacją).
// Obraz przechodzi przez ten sam pipeline co zdjęcia aptek (sharp→WebP, strip EXIF).
model PromoSlide {
  id        String   @id @default(cuid())
  imageUrl  String
  title     String?
  subtitle  String?
  href      String? // opcjonalny link po kliknięciu slajdu
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([active, sortOrder])
}

// =========================================================================
// UŻYTKOWNICY / AUTH
// =========================================================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String // argon2id
  role         Role     @default(PHARMACY_MANAGER)
  pharmacyId   String? // przypisane po zatwierdzonym claimie
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  pharmacy      Pharmacy?       @relation(fields: [pharmacyId], references: [id], onDelete: SetNull)
  refreshTokens RefreshToken[]
  claims        PharmacyClaim[]

  @@index([pharmacyId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  jti       String    @unique // identyfikator tokenu
  tokenHash String // hash refresh-tokenu (nie trzymamy plaintextu)
  family    String // rodzina rotacji — unieważniana przy reuse-detection
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
}

model PharmacyClaim {
  id         String      @id @default(cuid())
  userId     String
  pharmacyId String
  status     ClaimStatus @default(PENDING)
  evidence   String // uzasadnienie / nr zezwolenia
  reviewNote String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([pharmacyId])
}
