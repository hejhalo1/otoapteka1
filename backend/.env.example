# Szablon zmiennych środowiskowych — SKOPIUJ do pliku .env i uzupełnij prawdziwymi danymi.
# Ten plik (.env.example) trafia do gita jako dokumentacja, .env — nie (jest w .gitignore).

# --- Baza danych ---
# Format: postgresql://UŻYTKOWNIK:HASŁO@HOST:PORT/NAZWA_BAZY?schema=public
DATABASE_URL="postgresql://UZYTKOWNIK:HASLO@localhost:5432/otoapteka?schema=public"

# --- Serwer HTTP ---
PORT=3001
# Lista dozwolonych originów CORS po przecinku (frontend dev + produkcja).
CORS_ORIGINS="http://localhost:3000,https://otoapteka.pl"

# --- JWT (Faza 4) ---
# Wygeneruj osobne, długie sekrety, np.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="ZMIEN_MNIE_access"
JWT_REFRESH_SECRET="ZMIEN_MNIE_refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# --- Pierwszy administrator (seed, Faza 5) ---
# Konto ADMIN tworzone idempotentnie przez `npm run db:seed`.
ADMIN_EMAIL="admin@otoapteka.pl"
ADMIN_PASSWORD="ZMIEN_MNIE_silne_haslo"

# --- Warstwa geograficzna (OpenStreetMap) ---
# Geokodowanie adresów aptek (rate limit 1 req/s po naszej stronie).
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"
NOMINATIM_USER_AGENT="otoapteka.pl-sync/1.0 (kontakt@otoapteka.pl)"
# Silnik tras pieszo/autem. Publiczny serwer demo TYLKO do developmentu.
OSRM_BASE_URL="https://router.project-osrm.org"
# Włącznik OSRM: gdy false lub brak — używany jest estymator haversine (zawsze dostępny fallback).
OSRM_ENABLED="false"

# --- Synchronizacja z Rejestrem Aptek (Faza 1) ---
# Cron w strefie Europe/Warsaw (domyślnie codziennie o 3:00).
SYNC_CRON="0 3 * * *"
# Ile adresów geokodować w jednym przebiegu synca (rate limit Nominatim = 1 req/s,
# więc pełna baza ~21 tys. to wiele nocy; produkcyjnie rozważ self-host Nominatim).
GEOCODE_MAX_PER_RUN="500"

# --- Upload zdjęć (Faza 4) ---
UPLOADS_DIR="uploads"

# --- Rewalidacja frontendu on-demand (Faza 5) ---
# Współdzielony sekret chroniący endpoint rewalidacji Next.js.
REVALIDATE_SECRET="ZMIEN_MNIE_revalidate"
# Bazowy URL frontendu, do którego backend woła rewalidację.
FRONTEND_BASE_URL="http://localhost:3000"
